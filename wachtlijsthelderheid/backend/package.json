{
  "name": "wachtlijsthelderheid-backend",
  "version": "1.0.0",
  "description": "Backend API for WachtlijstHelderheid - Transparent Waitlist Management",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/initDb.js && node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/seed.js",
    "init-db": "node src/initDb.js",
    "test": "node tests/api.test.js",
    "test:ci": "node src/initDb.js && node src/index.js & sleep 3 && node tests/api.test.js; kill %1 2>/dev/null"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}
